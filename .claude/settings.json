{
  "permissions": {
    "allow": [
      "Read(//tmp/**)",
      "Bash(curl -s -o /dev/null -w \"root:%{http_code} \" http://localhost:3000/)",
      "Bash(curl -s -o /dev/null -w \"en:%{http_code} \" -L http://localhost:3000/en)",
      "Bash(curl -s -o /dev/null -w \"en-L-final:%{http_code}\\\\n\" -L http://localhost:3000/)",
      "Bash(curl -s http://localhost:3100/ar/play)",
      "Bash(curl -s http://localhost:3100/en/learn/arabic-numbers)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3100/llms.txt)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3100/author.svg)",
      "Bash(pkill -f \"next start\")",
      "Bash(pkill -f \"PORT=3100\")",
      "Bash(curl -s -o /dev/null -w \"3100 status: %{http_code} \\(000=stopped, good\\)\\\\n\" --max-time 2 http://localhost:3100/en)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" --max-time 2 http://localhost:3100/en)",
      "Bash(lsof -ti:3100)",
      "Bash(fuser 3100/tcp)",
      "Bash(kill -9 182107)",
      "Bash(git add *)",
      "Bash(git check-ignore *)",
      "Bash(git reset *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ]
  }
}
