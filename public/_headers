# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching

# Content-hashed build output — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Media and icons. Filenames are stable, so cache long but allow a revalidate
# window rather than pinning them immutable for a year.

# Generated from icon.svg by scripts/build-icons.mjs, so unlike the SVG these
# CAN be rewritten in place. A week rather than immutable, so a regenerated
# icon reaches people on its own instead of needing a CACHE_NAME bump.
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/icon-maskable-512.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/manifest.json
  Cache-Control: public, max-age=86400
/audio/*
  Cache-Control: public, max-age=31536000, immutable
/sounds/*
  Cache-Control: public, max-age=31536000, immutable
/pins/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Generated worksheet PDFs. Regenerated only when the worksheet script is rerun,
# so cache a week at the edge and let stale copies serve while revalidating.
/printables/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

# Point each PDF at the page that offers it, so Google ranks the page (with its
# download button and links to the rest of the site) instead of the bare file.
# Letter PDFs are searched in Arabic ("كتابة حرف الراء pdf"), so they point to
# /ar; the packs and stories are mostly searched in English, so they point to /en.
# Each placeholder matches one path segment, so the pack rule never catches a
# letter PDF (checked with wrangler dev).
/printables/letters/:letter.pdf
  Link: <https://www.arabfingers.site/ar/printables/letters/:letter>; rel="canonical"
/printables/:pack.pdf
  Link: <https://www.arabfingers.site/en/printables/:pack>; rel="canonical"
/stories/:story.pdf
  Link: <https://www.arabfingers.site/en/stories/:story>; rel="canonical"

# The service worker must never be cached, or a stale one pins an old build.
/sw.js
  Cache-Control: no-cache
