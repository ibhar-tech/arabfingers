# Cache Next.js static assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Cache media and icons
/icon.svg
  Cache-Control: public, max-age=31536000, immutable
/logo.svg
  Cache-Control: public, max-age=31536000, immutable
/manifest.json
  Cache-Control: public, max-age=31536000, immutable
/audio/*
  Cache-Control: public, max-age=31536000, immutable
/sounds/*
  Cache-Control: public, max-age=31536000, immutable
/pins/*
  Cache-Control: public, max-age=31536000, immutable
