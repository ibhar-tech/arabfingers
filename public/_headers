# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching

# Content-hashed build output — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Media and icons. Filenames are stable, so cache long but allow a revalidate
# window rather than pinning them immutable for a year.
/icon.svg
  Cache-Control: public, max-age=31536000, immutable
/logo.svg
  Cache-Control: public, max-age=31536000, immutable
/manifest.json
  Cache-Control: public, max-age=86400
/audio/*
  Cache-Control: public, max-age=31536000, immutable
/sounds/*
  Cache-Control: public, max-age=31536000, immutable
/pins/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Generated worksheet PDFs. Regenerated only when the worksheet script is rerun,
# so cache a week at the edge and let stale copies serve while revalidating.
/printables/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

# The service worker must never be cached, or a stale one pins an old build.
/sw.js
  Cache-Control: no-cache
