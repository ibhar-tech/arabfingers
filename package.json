{
  "name": "arabfingers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "dev": "next dev",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "knip": "knip",
    "worksheets": "node scripts/build-worksheets.mjs",
    "upload": "npm run build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.38.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.11.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "^0.184.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.20.14",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^20",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "happy-dom": "^20.11.6",
    "knip": "^6.32.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.155.0"
  },
  "browserslist": [
    "chrome >= 90",
    "firefox >= 90",
    "safari >= 15",
    "edge >= 90"
  ],
  "overrides": {
    "postcss": "^8.5.10",
    "@swc/helpers": "0.5.23"
  }
}
